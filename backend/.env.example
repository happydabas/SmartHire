# ==========================================
# 1. Application Settings
# ==========================================
PROJECT_NAME="SmartHire API"
VERSION="0.1.0"
ENV=development
DEBUG=true
API_V1_STR=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# ==========================================
# 2. CORS Settings
# ==========================================
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ==========================================
# 3. Logging Settings
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# ==========================================
# 4. Database Settings
# ==========================================
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=smarthire
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/smarthire
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# ==========================================
# 5. JWT Authentication Settings
# ==========================================
JWT_SECRET_KEY=placeholder_for_jwt_secret_key_change_me
JWT_REFRESH_SECRET_KEY=placeholder_for_jwt_refresh_secret_key_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# 6. Email Settings (Placeholder)
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=no-reply@smarthire.com

# ==========================================
# 7. File Upload Settings (Placeholder)
# ==========================================
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=app/uploads
